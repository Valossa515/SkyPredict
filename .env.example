# Credenciais da API Meteostat (via RapidAPI)
METEOSTAT_API_KEY=sua_chave_meteostat
METEOSTAT_API_HOST=meteostat.p.rapidapi.com

# Credencial da AeroAPI (FlightAware)
AEROAPI_KEY=sua_chave_aeroapi

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGOD_DB=skypredict
MONGO_COLLECTION=sugestoes

# Configurações opcionais da aplicação
# FLASK_DEBUG=false
# PORT=5000
# LOG_LEVEL=INFO

# Cache e modelo (opcionais)
# MODEL_CACHE_TTL_HOURS=24
# MIN_PROPHET_POINTS=60
# PROPHET_INTERVAL_WIDTH=0.8
# ENABLE_HYPERPARAMETER_TUNING=false
# HISTORICAL_START_DATE=2018-01-01
