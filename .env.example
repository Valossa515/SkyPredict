# Fonte de dados meteorológicos: auto | meteostat | openmeteo
#   auto (padrão): usa Meteostat se houver chave e cai para Open-Meteo em caso
#   de falha. Sem a chave do Meteostat, usa direto a Open-Meteo (sem chave!).
WEATHER_PROVIDER=auto

# Credenciais da API Meteostat (via RapidAPI) — OPCIONAIS quando WEATHER_PROVIDER
# usa Open-Meteo. Preencha para usar o Meteostat como fonte primária.
METEOSTAT_API_KEY=
METEOSTAT_API_HOST=meteostat.p.rapidapi.com

# Credencial da AeroAPI (FlightAware) — usada em /sugerir_rota e no modo
# padrão de /mapa_sugerido. O mapa também funciona sem ela via fonte=local.
AEROAPI_KEY=sua_chave_aeroapi

# MongoDB
MONGO_URI=mongodb://localhost:27017
MONGOD_DB=skypredict
MONGO_COLLECTION=sugestoes

# Configurações opcionais da aplicação
# FLASK_DEBUG=false
# PORT=5000
# LOG_LEVEL=INFO

# Cache e modelo (opcionais)
# MODEL_CACHE_TTL_HOURS=24
# MIN_PROPHET_POINTS=60
# PROPHET_INTERVAL_WIDTH=0.8
# ENABLE_HYPERPARAMETER_TUNING=false
# HISTORICAL_START_DATE=2018-01-01
